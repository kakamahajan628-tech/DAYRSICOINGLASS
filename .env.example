# Fill these in Render Environment. Never commit real values.
TELEGRAM_BOT_TOKEN=replace_with_BotFather_token
TELEGRAM_CHAT_ID=replace_with_numeric_chat_id
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE
RUN_SECRET=replace_with_unique_random_secret_at_least_24_characters
DASHBOARD_PASSWORD=replace_with_separate_unique_password_12_characters_minimum
COINGLASS_ENABLED=false
SYSTEM_ALERTS_ENABLED=true
TOP_N=15
SCAN_BUDGET_SECONDS=900
DATA_DIR=/tmp/coinglass-data
# Required for a group; optional for a private owner chat:
# TELEGRAM_OWNER_ID=123456789
# Optional official CMC listings key:
# CMC_API_KEY=
# Optional actual database expiry, with timezone:
# DATABASE_EXPIRES_AT=2026-12-25T06:00:00+05:30
# Local disposable tests only; do not use for Render persistence:
# ALLOW_EPHEMERAL_DB=true
# ALLOW_INSECURE_LOCAL=true
