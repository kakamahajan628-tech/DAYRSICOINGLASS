# Add these values to Render > Environment. Never commit a real .env file.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_PRIVATE_CHAT_ID
# Private-chat default owner = TELEGRAM_CHAT_ID. Required for a Telegram group:
# TELEGRAM_OWNER_ID=YOUR_PERSONAL_NUMERIC_USER_ID
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres
# Render Blueprint generates this automatically. Manual setup: random 32+ characters.
RUN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
TOP_N=15
SCAN_BUDGET_SECONDS=1200
DATA_DIR=/tmp/coinglass-data
PORT=10000
# Windows-only optional local browser setting; do not set on Render:
# BROWSER_CHANNEL=msedge
# Local experiments only. Ephemeral SQLite loses history after Render restart:
# ALLOW_EPHEMERAL_DB=true
# DATABASE_URL=sqlite:////tmp/watchlist.sqlite
